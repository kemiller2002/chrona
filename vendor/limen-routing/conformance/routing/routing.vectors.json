{
  "doc": "Language-neutral routing semantics (kemiller2002/limen#20, LCP-005). conformance/routing/README.md states the rules; these vectors are the rules as data. Any engine library in any language conforms by producing exactly these results from these tables. The F# reference library runs them in conformance/routing/fsharp/.",
  "tables": {
    "app": [
      { "name": "home", "path": "" },
      {
        "name": "invoices", "path": "invoices",
        "query": [ { "name": "page", "type": "int", "required": false }, { "name": "q", "type": "string", "required": false } ],
        "children": [
          { "name": "list", "path": "" },
          {
            "name": "invoice", "path": "{id:int}", "requires": ["invoice"],
            "query": [ { "name": "tab", "type": "string", "required": false } ],
            "children": [
              { "name": "summary", "path": "" },
              { "name": "history", "path": "history" },
              { "name": "line", "path": "lines/{line:int}" }
            ]
          }
        ]
      },
      { "name": "user", "path": "users/{handle:string}" },
      { "name": "search", "path": "search", "query": [ { "name": "term", "type": "string", "required": true } ] },
      { "name": "legacyInvoice", "path": "old/invoice/{id:int}", "redirect": { "to": "invoices.invoice.summary", "params": { "id": "{id}" } } },
      { "name": "loopA", "path": "loop/a", "redirect": { "to": "loopB", "params": {} } },
      { "name": "loopB", "path": "loop/b", "redirect": { "to": "loopA", "params": {} } },
      { "name": "admin", "path": "admin", "guard": "adminOnly" },
      { "name": "settings", "path": "settings", "guard": "signedIn" },
      { "name": "login", "path": "login", "query": [ { "name": "next", "type": "string", "required": false } ] },
      { "name": "files", "path": "files/{*path}" },
      { "name": "notFound", "path": "{*rest}" }
    ],
    "strict": [
      { "name": "home", "path": "" },
      { "name": "item", "path": "items/{id:int}" }
    ]
  },
  "resolve": [
    { "name": "root", "table": "app", "path": "/", "query": "", "expect": { "kind": "Matched", "route": "home", "chain": [ { "route": "home", "params": {} } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "empty path is root", "table": "app", "path": "", "query": "", "expect": { "kind": "Matched", "route": "home", "chain": [ { "route": "home", "params": {} } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "nested index", "table": "app", "path": "/invoices", "query": "", "expect": { "kind": "Matched", "route": "invoices.list", "chain": [ { "route": "invoices", "params": {} }, { "route": "list", "params": {} } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "trailing slash is ignored", "table": "app", "path": "/invoices/", "query": "", "expect": { "kind": "Matched", "route": "invoices.list", "chain": [ { "route": "invoices", "params": {} }, { "route": "list", "params": {} } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "repeated slashes are ignored", "table": "app", "path": "//invoices//42//", "query": "", "expect": { "kind": "Matched", "route": "invoices.invoice.summary", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 42 } }, { "route": "summary", "params": {} } ], "query": {}, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "nested typed parameter", "table": "app", "path": "/invoices/42/history", "query": "", "expect": { "kind": "Matched", "route": "invoices.invoice.history", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 42 } }, { "route": "history", "params": {} } ], "query": {}, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "parameters at two levels", "table": "app", "path": "/invoices/42/lines/3", "query": "", "expect": { "kind": "Matched", "route": "invoices.invoice.line", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 42 } }, { "route": "line", "params": { "line": 3 } } ], "query": {}, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "negative int", "table": "app", "path": "/invoices/-7", "query": "", "expect": { "kind": "Matched", "route": "invoices.invoice.summary", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": -7 } }, { "route": "summary", "params": {} } ], "query": {}, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "typed parameter failure: not an int", "table": "app", "path": "/invoices/abc", "query": "", "expect": { "kind": "Invalid", "route": "invoices.invoice", "parameter": "id", "value": "abc", "expected": "int" } },
    { "name": "typed parameter failure: leading zero is not canonical", "table": "app", "path": "/invoices/042", "query": "", "expect": { "kind": "Invalid", "route": "invoices.invoice", "parameter": "id", "value": "042", "expected": "int" } },
    { "name": "typed parameter failure: beyond 53-bit safe", "table": "app", "path": "/invoices/9007199254740992", "query": "", "expect": { "kind": "Invalid", "route": "invoices.invoice", "parameter": "id", "value": "9007199254740992", "expected": "int" } },
    { "name": "53-bit safe maximum", "table": "app", "path": "/invoices/9007199254740991", "query": "", "expect": { "kind": "Matched", "route": "invoices.invoice.summary", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 9007199254740991 } }, { "route": "summary", "params": {} } ], "query": {}, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "typed failure is not hidden by the wildcard", "table": "app", "path": "/invoices/1.5/history", "query": "", "expect": { "kind": "Invalid", "route": "invoices.invoice", "parameter": "id", "value": "1.5", "expected": "int" } },
    { "name": "percent-decoded string parameter", "table": "app", "path": "/users/ada%20lovelace", "query": "", "expect": { "kind": "Matched", "route": "user", "chain": [ { "route": "user", "params": { "handle": "ada lovelace" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "encoded slash stays inside one segment", "table": "app", "path": "/users/a%2Fb", "query": "", "expect": { "kind": "Matched", "route": "user", "chain": [ { "route": "user", "params": { "handle": "a/b" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "UTF-8 parameter", "table": "app", "path": "/users/%C3%A9mile", "query": "", "expect": { "kind": "Matched", "route": "user", "chain": [ { "route": "user", "params": { "handle": "émile" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "malformed escape", "table": "app", "path": "/users/%zz", "query": "", "expect": { "kind": "MalformedPath" } },
    { "name": "truncated escape", "table": "app", "path": "/users/abc%4", "query": "", "expect": { "kind": "MalformedPath" } },
    { "name": "invalid UTF-8", "table": "app", "path": "/users/%C3", "query": "", "expect": { "kind": "MalformedPath" } },
    { "name": "literals are case-sensitive: falls to the wildcard", "table": "app", "path": "/Invoices", "query": "", "expect": { "kind": "Matched", "route": "notFound", "chain": [ { "route": "notFound", "params": { "rest": "Invoices" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "query parsing: typed, decoded, + is space, undeclared ignored", "table": "app", "path": "/invoices", "query": "?page=2&q=acme+corp%21&utm=x", "expect": { "kind": "Matched", "route": "invoices.list", "chain": [ { "route": "invoices", "params": {} }, { "route": "list", "params": {} } ], "query": { "page": 2, "q": "acme corp!" }, "requires": [], "redirectedFrom": [] } },
    { "name": "query from every level of the chain", "table": "app", "path": "/invoices/42/history", "query": "?tab=notes&page=3", "expect": { "kind": "Matched", "route": "invoices.invoice.history", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 42 } }, { "route": "history", "params": {} } ], "query": { "page": 3, "tab": "notes" }, "requires": ["invoice"], "redirectedFrom": [] } },
    { "name": "query without leading question mark", "table": "app", "path": "/invoices", "query": "page=5", "expect": { "kind": "Matched", "route": "invoices.list", "chain": [ { "route": "invoices", "params": {} }, { "route": "list", "params": {} } ], "query": { "page": 5 }, "requires": [], "redirectedFrom": [] } },
    { "name": "query typed failure", "table": "app", "path": "/invoices", "query": "?page=two", "expect": { "kind": "Invalid", "route": "invoices", "parameter": "page", "value": "two", "expected": "int" } },
    { "name": "repeated declared query key is ambiguous", "table": "app", "path": "/invoices", "query": "?page=1&page=2", "expect": { "kind": "Invalid", "route": "invoices", "parameter": "page", "value": "1,2", "expected": "a single value" } },
    { "name": "required query parameter missing", "table": "app", "path": "/search", "query": "", "expect": { "kind": "Invalid", "route": "search", "parameter": "term", "value": "", "expected": "string (required)" } },
    { "name": "required query parameter present and empty", "table": "app", "path": "/search", "query": "?term=", "expect": { "kind": "Matched", "route": "search", "chain": [ { "route": "search", "params": {} } ], "query": { "term": "" }, "requires": [], "redirectedFrom": [] } },
    { "name": "key without value", "table": "app", "path": "/search", "query": "?term", "expect": { "kind": "Matched", "route": "search", "chain": [ { "route": "search", "params": {} } ], "query": { "term": "" }, "requires": [], "redirectedFrom": [] } },
    { "name": "malformed query escape", "table": "app", "path": "/search", "query": "?term=%zz", "expect": { "kind": "MalformedQuery" } },
    { "name": "wildcard fallback captures the rest", "table": "app", "path": "/no/such/page", "query": "", "expect": { "kind": "Matched", "route": "notFound", "chain": [ { "route": "notFound", "params": { "rest": "no/such/page" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "wildcard may capture nothing", "table": "app", "path": "/files", "query": "", "expect": { "kind": "Matched", "route": "files", "chain": [ { "route": "files", "params": { "path": "" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "wildcard keeps decoded segments", "table": "app", "path": "/files/a%20b/c", "query": "", "expect": { "kind": "Matched", "route": "files", "chain": [ { "route": "files", "params": { "path": "a b/c" } } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "no wildcard: NotFound", "table": "strict", "path": "/nothing", "query": "", "expect": { "kind": "NotFound" } },
    { "name": "no wildcard: extra segment is NotFound", "table": "strict", "path": "/items/1/extra", "query": "", "expect": { "kind": "NotFound" } },
    { "name": "redirect with parameter mapping", "table": "app", "path": "/old/invoice/9", "query": "?tab=history", "expect": { "kind": "Matched", "route": "invoices.invoice.summary", "chain": [ { "route": "invoices", "params": {} }, { "route": "invoice", "params": { "id": 9 } }, { "route": "summary", "params": {} } ], "query": { "tab": "history" }, "requires": ["invoice"], "redirectedFrom": ["legacyInvoice"] } },
    { "name": "redirect loop is rejected", "table": "app", "path": "/loop/a", "query": "", "expect": { "kind": "RedirectLoop", "chain": ["loopA", "loopB", "loopA"] } },
    { "name": "guard allows", "table": "app", "path": "/admin", "query": "", "guards": { "adminOnly": "allow" }, "expect": { "kind": "Matched", "route": "admin", "chain": [ { "route": "admin", "params": {} } ], "query": {}, "requires": [], "redirectedFrom": [] } },
    { "name": "guard denies", "table": "app", "path": "/admin", "query": "", "guards": { "adminOnly": "deny" }, "expect": { "kind": "Denied", "route": "admin" } },
    { "name": "guard redirects", "table": "app", "path": "/settings", "query": "", "guards": { "signedIn": { "redirect": { "to": "login", "params": {}, "query": { "next": "/settings" } } } }, "expect": { "kind": "Matched", "route": "login", "chain": [ { "route": "login", "params": {} } ], "query": { "next": "/settings" }, "requires": [], "redirectedFrom": ["settings"] } },
    { "name": "guard redirect loop is rejected", "table": "app", "path": "/admin", "query": "", "guards": { "adminOnly": { "redirect": { "to": "settings", "params": {}, "query": {} } }, "signedIn": { "redirect": { "to": "admin", "params": {}, "query": {} } } }, "expect": { "kind": "RedirectLoop", "chain": ["admin", "settings", "admin"] } }
  ],
  "build": [
    { "name": "root", "table": "app", "route": "home", "params": {}, "query": {}, "expect": { "ok": "/" } },
    { "name": "nested with parameter", "table": "app", "route": "invoices.invoice.history", "params": { "id": 42 }, "query": {}, "expect": { "ok": "/invoices/42/history" } },
    { "name": "index child builds the parent's path", "table": "app", "route": "invoices.list", "params": {}, "query": { "page": 2 }, "expect": { "ok": "/invoices?page=2" } },
    { "name": "query in declaration order, parent first, absent omitted", "table": "app", "route": "invoices.invoice.summary", "params": { "id": 7 }, "query": { "tab": "notes", "page": 1 }, "expect": { "ok": "/invoices/7?page=1&tab=notes" } },
    { "name": "segments and query values are percent-encoded", "table": "app", "route": "user", "params": { "handle": "ada lovelace/ü" }, "query": {}, "expect": { "ok": "/users/ada%20lovelace%2F%C3%BC" } },
    { "name": "query encoding uses %20, never +", "table": "app", "route": "search", "params": {}, "query": { "term": "a b&c=d" }, "expect": { "ok": "/search?term=a%20b%26c%3Dd" } },
    { "name": "wildcard segments are encoded one by one", "table": "app", "route": "files", "params": { "path": "a b/c" }, "query": {}, "expect": { "ok": "/files/a%20b/c" } },
    { "name": "missing parameter", "table": "app", "route": "invoices.invoice.summary", "params": {}, "query": {}, "expect": { "error": "MissingParameter", "parameter": "id" } },
    { "name": "wrongly typed parameter", "table": "app", "route": "invoices.invoice.summary", "params": { "id": "seven" }, "query": {}, "expect": { "error": "InvalidParameter", "parameter": "id" } },
    { "name": "missing required query", "table": "app", "route": "search", "params": {}, "query": {}, "expect": { "error": "MissingParameter", "parameter": "term" } },
    { "name": "unknown route", "table": "app", "route": "nope", "params": {}, "query": {}, "expect": { "error": "UnknownRoute", "parameter": "" } },
    { "name": "a route with children is not a destination", "table": "app", "route": "invoices", "params": {}, "query": {}, "expect": { "error": "UnknownRoute", "parameter": "" } }
  ],
  "sessions": [
    {
      "name": "deep link, in-app navigation, Back and Forward",
      "table": "app",
      "steps": [
        { "adopt": "/old/invoice/9?tab=history", "expect": { "route": "invoices.invoice.summary", "effect": { "replace": "/invoices/9?tab=history" } } },
        { "navigate": { "route": "invoices.invoice.history", "params": { "id": 9 }, "query": {} }, "expect": { "route": "invoices.invoice.history", "effect": { "push": "/invoices/9/history" } } },
        { "navigate": { "route": "invoices.invoice.history", "params": { "id": 9 }, "query": {} }, "expect": { "route": "invoices.invoice.history", "effect": null } },
        { "adopt": "/invoices/9?tab=history", "expect": { "route": "invoices.invoice.summary", "effect": null } },
        { "adopt": "/invoices/9/history", "expect": { "route": "invoices.invoice.history", "effect": null } },
        { "adopt": "/invoices/9/history/", "expect": { "route": "invoices.invoice.history", "effect": { "replace": "/invoices/9/history" } } },
        { "adopt": "/invoices?utm=campaign&page=2", "expect": { "route": "invoices.list", "effect": { "replace": "/invoices?page=2" } } },
        { "adopt": "/no/such/page", "expect": { "route": "notFound", "effect": null } },
        { "adopt": "/invoices/abc", "expect": { "route": null, "effect": null } }
      ]
    }
  ]
}
