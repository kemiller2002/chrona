<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs conformance/routing/routing.vectors.json against the F# reference
       routing library. Test harness, not a library: it reads the vectors from
       disk, which libraries/** may not. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <OtherFlags>$(OtherFlags) --warnon:1182 --warnaserror:25</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../libraries/fsharp/Limen.Routing/Limen.Routing.fsproj" />
  </ItemGroup>
</Project>
