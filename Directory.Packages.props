<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- EchelonFoundry.Aegis.Core requires FSharp.Core >= 10.1.400 and the
         Fides packages >= 10.1.401. The F# SDK
         would otherwise inject an older FSharp.Core implicitly and NuGet would
         report a downgrade, so the version is pinned here and the implicit
         reference is disabled in Directory.Build.props. -->
    <PackageVersion Include="FSharp.Core" Version="10.1.401" />
    <PackageVersion Include="EchelonFoundry.Aegis.Core" Version="1.0.0" />
    <!-- Arca 0.3.0: attested GitHub release assets in vendor/nuget, installed
         and proven by Conditor (conditor.json, vendor/nuget/arca.lock). -->
    <PackageVersion Include="EchelonFoundry.Arca.Core" Version="0.4.1" />
    <PackageVersion Include="EchelonFoundry.Arca.GitHub" Version="0.4.1" />
    <!-- Fides 0.2.0, the same way (vendor/nuget/fides.lock): the WASM sign-in
         client and its bridge to Arca's token-provider port. Fides.Hosting
         is the exchange's server side and is not referenced. -->
    <PackageVersion Include="EchelonFoundry.Fides" Version="0.2.0" />
    <PackageVersion Include="EchelonFoundry.Fides.Client" Version="0.2.0" />
    <PackageVersion Include="EchelonFoundry.Fides.Arca" Version="0.2.0" />
    <!-- Summa's Chrona-to-Summa billing contract 0.1.0 (wire contract
         summa.chrona-billing 1.0), the same way (vendor/nuget/
         summa-contracts.lock). Summa owns it; Chrona.Integration maps onto it. -->
    <PackageVersion Include="EchelonFoundry.Summa.Contracts" Version="0.1.0" />
    <!-- Limen 0.9.0's routing library (limen-fsharp, echelon-current 1.11.0),
         the same way (vendor/nuget/limen-fsharp.lock): the URL-state
         semantics Chrona's places are a codec over (CHX-460,
         DF-CHRONA-2026-0007). -->
    <PackageVersion Include="EchelonFoundry.Limen.Routing" Version="0.9.0" />
    <!-- Arca's offline queue in IndexedDB and its read cache over Limen's
         store pack (WI-0059, WI-0057). Arca.Limen asks for Limen.Store and
         Limen.Contract 0.8.0 or later; Chrona holds 0.9.0 (limen-fsharp),
         pinned here so restore takes exactly that. -->
    <PackageVersion Include="EchelonFoundry.Arca.Limen" Version="0.4.1" />
    <PackageVersion Include="EchelonFoundry.Limen.Store" Version="0.9.0" />
    <PackageVersion Include="EchelonFoundry.Limen.Contract" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
