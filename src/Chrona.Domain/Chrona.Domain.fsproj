<Project Sdk="Microsoft.NET.Sdk">

  <!-- Chrona's time domain (requirements expansion 0.4): the authoritative
       activity record, its separate state dimensions, entry and overlap
       rules, legal transitions and their diagnostics. Pure F#: no clock,
       storage, network, browser or file-system access (the current instant
       and time-zone rules arrive as arguments). Its one package dependency
       beyond FSharp.Core is Arca.Core, which is pure in the same sense. -->

  <ItemGroup>
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Time.fs" />
    <Compile Include="Activity.fs" />
    <Compile Include="Access.fs" />
    <Compile Include="Reference.fs" />
    <Compile Include="Overlap.fs" />
    <Compile Include="ManualEntry.fs" />
    <Compile Include="Ledger.fs" />
    <Compile Include="Timer.fs" />
    <Compile Include="Billing.fs" />
    <Compile Include="Review.fs" />
    <Compile Include="Periods.fs" />
    <Compile Include="PeriodReview.fs" />
    <Compile Include="Reports.fs" />
    <Compile Include="Observations.fs" />
    <Compile Include="Compatibility.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="Organization.fs" />
    <Compile Include="Deployment.fs" />
    <Compile Include="Governance.fs" />
    <Compile Include="Storage.fs" />
    <Compile Include="ActivityRecord.fs" />
    <Compile Include="ReferenceRecord.fs" />
    <Compile Include="AttestationRecord.fs" />
    <Compile Include="AuditRecord.fs" />
    <Compile Include="PeriodConfigRecord.fs" />
    <Compile Include="ReviewRecord.fs" />
    <Compile Include="CandidateRecord.fs" />
    <Compile Include="ReceiptRecord.fs" />
    <Compile Include="TimerRecord.fs" />
    <Compile Include="MemberRecord.fs" />
    <Compile Include="Persistence.fs" />
    <Compile Include="Stored.fs" />
    <Compile Include="Reconcile.fs" />
    <Compile Include="ActivityIndex.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Arca's pure storage domain (locations, namespaces, records,
         operations): no I/O, clock or randomness, so the domain stays pure.
         Restored from vendor/nuget (NuGet.config, installed by Conditor). -->
    <PackageReference Include="EchelonFoundry.Arca.Core" />
  </ItemGroup>

</Project>
