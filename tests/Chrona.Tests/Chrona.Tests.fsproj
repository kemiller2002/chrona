<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests read JSON through indexers that are nullable by annotation;
         a missing value fails the assertion that reads it. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

