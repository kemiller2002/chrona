<Project Sdk="Microsoft.NET.Sdk">

  <!-- Limen engine, application tier: Limen's protocol (JSON in, view and effects out)
       and the Aegis boundary every kernel message crosses. Deterministic
       apart from the Aegis fault ids and timestamps; no browser, network or
       file access: Fides' sign-in client runs here, and every browser
       service it needs is a Limen request (Identity.fs). -->

  <ItemGroup>
    <Compile Include="Json.fs" />
    <Compile Include="Limen.fs" />
    <Compile Include="Boundary.fs" />
    <Compile Include="Wire.fs" />
    <Compile Include="AppProtocol.fs" />
    <Compile Include="Bridge.fs" />
    <Compile Include="Identity.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Runtime.fs" />
  </ItemGroup>

  <!-- The Chrona build a page runs (WI-0063): the publish of the WebAssembly
       build passes ChronaBuildId and writes the same id beside it
       (chrona-build.json), so a page can tell when the deployment serves a
       newer Chrona. Unset, it is `development` and never compared. -->
  <PropertyGroup>
    <ChronaBuildId Condition="'$(ChronaBuildId)' == ''">development</ChronaBuildId>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ChronaBuildId</_Parameter1>
      <_Parameter2>$(ChronaBuildId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Aegis.Core" />
    <PackageReference Include="EchelonFoundry.Fides" />
    <PackageReference Include="EchelonFoundry.Fides.Client" />
    <PackageReference Include="EchelonFoundry.Fides.Arca" />
    <PackageReference Include="EchelonFoundry.Arca.GitHub" />
    <PackageReference Include="EchelonFoundry.Arca.Limen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Chrona.Engine/Chrona.Engine.fsproj" />
  </ItemGroup>

</Project>
