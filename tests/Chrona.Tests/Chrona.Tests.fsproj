<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Tests read JSON through indexers that are nullable by annotation;
         a missing value fails the assertion that reads it. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Support.fs" />
    <Compile Include="KernelSliceTests.fs" />
    <Compile Include="TransportTests.fs" />
    <Compile Include="BoundaryTests.fs" />
    <Compile Include="FoundationsConformanceTests.fs" />
    <Compile Include="BindingAgreementTests.fs" />
    <Compile Include="GapAnalysisTests.fs" />
    <Compile Include="TimeDomainTests.fs" />
    <Compile Include="LedgerTests.fs" />
    <Compile Include="TimerTests.fs" />
    <Compile Include="ReviewBillingTests.fs" />
    <Compile Include="BrandTokenTests.fs" />
    <Compile Include="CompatibilityTests.fs" />
    <Compile Include="LegacyRuleTests.fs" />
    <Compile Include="ReferenceTests.fs" />
    <Compile Include="PeriodTests.fs" />
    <Compile Include="ReportTests.fs" />
    <Compile Include="ObservationTests.fs" />
    <Compile Include="StorageTests.fs" />
    <Compile Include="PersistenceTests.fs" />
    <Compile Include="SignInTests.fs" />
    <Compile Include="AccessTests.fs" />
    <Compile Include="StoreTests.fs" />
    <Compile Include="GovernanceTests.fs" />
    <Compile Include="PlacesTests.fs" />
    <Compile Include="AppEngineTests.fs" />
    <Compile Include="AppBoundaryTests.fs" />
    <Compile Include="DeepLinkTests.fs" />
    <Compile Include="SummaBillingTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="EchelonFoundry.Aegis.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Chrona.Domain/Chrona.Domain.fsproj" />
    <ProjectReference Include="../../src/Chrona.Engine/Chrona.Engine.fsproj" />
    <ProjectReference Include="../../src/Chrona.Application/Chrona.Application.fsproj" />
    <ProjectReference Include="../../src/Chrona.Summa/Chrona.Summa.fsproj" />
  </ItemGroup>

</Project>
