{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/visual-engineering/blob/main/framework/contracts/ui-conformance.schema.json",
  "title": "Echelon Universal UI Conformance Evidence v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standardVersion",
    "repository",
    "revision",
    "classification",
    "surfaces"
  ],
  "properties": {
    "standardVersion": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "revision": {
      "type": "string",
      "minLength": 7
    },
    "classification": {
      "enum": [
        "app-ui",
        "site-ui",
        "demo-ui",
        "print-ui",
        "service-no-ui",
        "archived",
        "unknown"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      },
      "default": []
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "semanticLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alignmentGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relation",
        "targets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "top-edge",
            "text-baseline",
            "centerline",
            "bottom-edge"
          ]
        },
        "toleranceCssPx": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "targets": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/semanticLocator"
          }
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "control",
        "intent",
        "expectedOutcome",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "$ref": "#/$defs/semanticLocator"
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "expectedOutcome": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unassessed",
            "pass",
            "fail",
            "unknown",
            "not-applicable",
            "exception"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "resetStrategy": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "kind",
        "status",
        "viewportWidths",
        "alignmentGroups",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "product",
            "marketing",
            "catalog",
            "demo",
            "print",
            "editor",
            "other"
          ]
        },
        "status": {
          "enum": [
            "unassessed",
            "pass",
            "fail",
            "unknown",
            "not-applicable",
            "exception"
          ]
        },
        "viewportWidths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "alignmentGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alignmentGroup"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "unknownScope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "surface",
        "reason",
        "owner",
        "reviewTrigger"
      ],
      "properties": {
        "ruleId": {
          "type": "string",
          "pattern": "^ULI-[LA][0-9]{2}$"
        },
        "surface": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 10
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "reviewTrigger": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
