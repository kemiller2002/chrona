# Operating-system files
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# Generated transient work
.ros/locks/
work/staging/*
work/review/*
logs/*

# Preserve directory markers and documentation
!work/staging/.gitkeep
!work/review/.gitkeep
!logs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Project-owned additions (deliberate divergence from the ROS-managed
# template, recorded under WI-0006; ros-bootstrap verify will report it).
# Build and test output.
bin/
obj/
build/
test-results/
playwright-report/

